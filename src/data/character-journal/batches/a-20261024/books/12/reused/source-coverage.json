  "spotChecks": [
    {
      "topic": "无敌之死",
      "sourceRanges": [
        "text00310:p0072–p0093"
      ],
      "result": "终止无法及时救治的痛苦，同时隐瞒自身责任；不能写成单纯意外或注定作恶。"
    },
    {
      "topic": "圣光的回应",
      "sourceRanges": [
        "text00311:p0036–p0042",
        "text00322:p0083–p0090"
      ],
      "result": "受封确实获得圣光，取剑前治疗穆拉丁时圣光再次回应；不是从未被接纳或当时已无选择。"
    },
    {
      "topic": "斯坦索姆的不确定性",
      "sourceRanges": [
        "text00319:p0013–p0036"
      ],
      "result": "感染总数、剂量未知；没有证明所有居民感染，也没有已验证有效的替代救治方案。不可将任一方推断升级为既成事实。"
    },
    {
      "topic": "取剑主动性",
      "sourceRanges": [
        "text00322:p0060–p0092"
      ],
      "result": "明确听见灵魂损伤警告、拒绝离开，获圣光回应后受武器耳语诱惑而转向握剑；须并陈操纵与主动选择。"
    },
    {
      "topic": "希尔瓦娜斯",
      "sourceRanges": [
        "text00327:p0040–p0069"
      ],
      "result": "守土战败、被刺杀、强制女妖化及痛苦奴役；行为被控制而意志仍反抗。阿尔萨斯归咎她抵抗是施害者说法。"
    },
    {
      "topic": "伊利丹重伤",
      "sourceRanges": [
        "text00332:p0091–p0098"
      ],
      "result": "倒地仍喘息，王子决定留给严寒；本段不确认死亡。"
    },
    {
      "topic": "首尾梦境收束",
      "sourceRanges": [
        "text00306:p0017–p0035",
        "text00333:p0001–p0040",
        "text00333:p0042–p0059"
      ],
      "result": "同一虚幻长桌框架，尾声明认男孩为残余人性、兽人为耐奥祖；梦中斩除两者后现实睁眼。最后叙事p0056，后为作者介绍。"
    }
  ],
