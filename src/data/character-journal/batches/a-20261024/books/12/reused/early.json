        "text00309:p0110"
      ]
    },
    {
      "id": "E11",
      "kind": "fact",
      "summary": "十七岁突查敦霍尔德兼有财政监管和观看萨尔的好奇；他看出布莱克摩尔酗酒、塔蕾莎受辱，仍被角斗娱乐吸引，并忧心萨尔逃走传播战技。",
      "sourceRefs": [
        "text00310:p0005",
        "text00310:p0006",
        "text00310:p0010",
        "text00310:p0012",
        "text00310:p0018",
        "text00310:p0021",
