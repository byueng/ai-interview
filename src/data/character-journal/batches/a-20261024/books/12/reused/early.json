      ]
    },
    {
      "id": "E19",
      "kind": "fact",
      "summary": "秘密恋情被凯尔萨斯撞见，公开追求与名誉保护发生争执；阿尔萨斯因自觉不如凯尔而嫉妒，经吉安娜确认选择而缓解。他仍持续训练，并把无敌之死解释为训练开始太晚。",
      "sourceRefs": [
        "text00314:p0019",
        "text00314:p0020",
        "text00314:p0021",
        "text00314:p0027",
        "text00314:p0028",
        "text00314:p0032",
        "text00314:p0033"
      ]
    },
    {
      "id": "E20",
      "kind": "fact",
      "summary": "双方长辈默许恋情，他渐接公共职责；万圣节把点火荣耀交给吉安娜，与民同庆并在当夜发展亲密关系。满足中突然恐惧被拒绝，要求她永不拒绝自己。",
      "sourceRefs": [
        "text00314:p0035",
        "text00314:p0037",
        "text00314:p0051",
        "text00314:p0053",
        "text00314:p0056",
