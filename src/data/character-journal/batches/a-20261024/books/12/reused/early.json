  "events": [
    {
      "id": "E01",
      "kind": "fact",
      "summary": "序章以北方非自然风暴和梦中人类男人、骷髅面兽人、病弱男孩的争论构成框架；男孩坚持尚未全输。",
      "sourceRefs": [
        "text00306:p0007",
        "text00306:p0018",
        "text00306:p0019",
        "text00306:p0024",
        "text00306:p0027",
        "text00306:p0033",
        "text00306:p0035"
      ],
      "interpretation": "序章没有明文给三者全部点名；身份和象征意义须跨章核对。不能把梦中桌前场景写成现实会晤。"
    },
    {
      "id": "E02",
      "kind": "fact",
      "summary": "九岁的阿尔萨斯在巴尼尔农场协助亮鬃产驹，与平民佳力姆亲近，对新生马驹产生强烈联结。",
      "sourceRefs": [
        "text00307:p0004",
        "text00307:p0005",
        "text00307:p0009",
        "text00307:p0012"
      ]
    },
    {
      "id": "E03",
      "kind": "fact",
      "summary": "得知暴风城失陷、莱恩死亡后，他真切同情瓦里安；秘密旁听会谈后，以邀请看马驹笨拙安慰丧亲的同龄人。",
      "sourceRefs": [
        "text00307:p0023",
        "text00307:p0031",
        "text00307:p0032",
        "text00307:p0064",
        "text00307:p0091",
        "text00307:p0093",
        "text00307:p0094"
      ]
    },
    {
      "id": "E04",
      "kind": "fact",
      "summary": "父王接见平民、尊重并庇护瓦里安的做法成为可见的仁政榜样；阿尔萨斯同时因被排除重大会议而生气。",
      "sourceRefs": [
        "text00307:p0058",
        "text00307:p0059",
        "text00307:p0062",
        "text00307:p0073",
        "text00307:p0085"
      ]
    },
    {
      "id": "E05",
      "kind": "fact",
      "summary": "阿尔萨斯在瓦里安面前感到训练不足；战后毁灭之锤受保护和逃脱的叙述，置于他对兽人的敌视认知中。",
      "sourceRefs": [
        "text00308:p0002",
        "text00308:p0011",
        "text00308:p0012",
        "text00308:p0015",
        "text00308:p0018",
        "text00308:p0020"
      ],
      "interpretation": "逃脱部分标明小道消息与无人活报，不能把末尾可能已死当成事实；战败兽人的负面形容保留视角属性。"
    },
    {
      "id": "E06",
      "kind": "fact",
      "summary": "十一岁时违背驯马师警告偷骑两岁无敌，摔落且马腿割伤；他隐瞒真相，被乌瑟尔识破并训诫。",
      "sourceRefs": [
        "text00308:p0024",
        "text00308:p0042",
        "text00308:p0044",
        "text00308:p0049",
        "text00308:p0053",
        "text00308:p0054",
        "text00308:p0058"
      ]
    },
    {
      "id": "E07",
      "kind": "fact",
      "summary": "礼拜时初识吉安娜；穆拉丁主动提出担任严格战技导师，父王许可，同时增加圣骑士和君主课程。",
      "sourceRefs": [
        "text00308:p0072",
        "text00308:p0079",
        "text00308:p0086",
        "text00308:p0088",
        "text00309:p0003"
      ]
    },
    {
      "id": "E08",
      "kind": "fact",
      "summary": "护送吉安娜前往达拉然时，他带她夜窥战俘营。吉安娜看到兽人家庭与婴儿而同情，阿尔萨斯仍把他们视作潜在杀手。",
      "sourceRefs": [
        "text00309:p0004",
        "text00309:p0031",
        "text00309:p0039",
