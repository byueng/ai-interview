  "facts": [
    {
      "id": "19-f001",
      "type": "fact",
      "characters": [
        "thrall"
      ],
      "summary": "开篇回顾死亡之翼已被巨龙与兽人共同击败、守护巨龙失去神力；本书发生于18之后，并非18结尾直接杀死死亡之翼。",
      "sourceRefs": [
        "text00552:p0003-p0005"
      ]
    },
    {
      "id": "19-f002",
      "type": "fact",
      "characters": [
        "voljin",
        "thrall"
      ],
      "summary": "加尔鲁什宣称萨尔已交权，其想法不再重要。沃金反对逐走暗夜精灵，认为会给联盟战争借口；因受辱搬离奥格瑞玛，后为保护近城族人克制发言。贝恩对比两任酋长作风是人物视角。",
      "sourceRefs": [
        "text00553:p0046-p0056",
        "text00553:p0083-p0097"
      ]
    },
    {
      "id": "19-f003",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "秘密会面中萨尔改穿萨满长袍、背毁灭之锤，要求称古伊尔，自述现为大地之环领袖；接替大地守护者职责但将胜利归巨龙和各族，不据此称真正守护巨龙。",
      "sourceRefs": [
        "text00554:p0013-p0026"
      ]
    },
    {
      "id": "19-f004",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina",
        "varian"
      ],
      "summary": "吉安娜要求他阻止加尔鲁什挑战、提议联合贝恩与瓦里安召开首领会。萨尔知道奥格瑞玛灰谷情况但强调其他使命、联盟亦有责任，未同意介入。她认为被辜负，同时承认说他一直袖手旁观不公平。",
      "sourceRefs": [
        "text00554:p0029-p0046"
      ]
    },
    {
      "id": "19-f005",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "萨尔述阿格娜为玛格汉萨满、共同疗愈世界并疗愈他；认为伴侣接纳完整自我令他振作，祝吉安娜找到幸福，双方仍以朋友相待。",
      "sourceRefs": [
        "text00554:p0050-p0062"
      ]
    },
    {
      "id": "19-f006",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "吉安娜在罗宁建议下收金迪为徒，同时知道金迪需向肯瑞托报告；由怀念导师转为愿传承魔法，逐渐为学生骄傲。她现为独立领主，不属肯瑞托。",
      "sourceRefs": [
        "text00555:p0010-p0044"
      ]
    },
    {
      "id": "19-f007",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "吉安娜信任卡雷求助、召集特沃什金迪蓓恩查聚焦之虹；她怀念学习快乐，卡雷分享责任与喜悦的魔法观，关系初步靠近。",
      "sourceRefs": [
        "text00556:p0020-p0077",
        "text00556:p0088-p0114"
      ]
    },
    {
      "id": "19-f008",
      "type": "fact",
      "characters": [
        "voljin"
      ],
      "summary": "沃金带巨魔与贝恩联军攻击联盟岗哨；私下述异见者被捕殴打失踪与自身谨慎，不能写成仅和平旁观者；对于加尔鲁什是否直接知情明确表示无法确定。",
      "sourceRefs": [
        "text00557:p0004-p0031"
      ]
    },
    {
      "id": "19-f009",
      "type": "fact",
      "characters": [
        "jaina",
        "thrall",
        "varian"
      ],
      "summary": "吉安娜向卡雷倾诉萨尔瓦里安等不听劝的无力感；卡雷以变化的数学魔法形象说明变化可能，随后获知部落集结。情绪为她的视角，不证明所有努力无效。",
      "sourceRefs": [
        "text00557:p0085-p0117"
      ]
    },
    {
      "id": "19-f010",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "为查危险神器而未去北方城堡，回忆安东尼达斯命她离开受攻的达拉然。与12版本相关场景需保留冲突，不默默合并。随后推断变形术掩盖聚焦之虹，协助卡雷重新追踪。",
      "sourceRefs": [
        "text00560:p0008-p0038"
      ]
    },
    {
      "id": "19-f011",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "贝恩以破惧者为信物派佩里斯警告塞拉摩将受攻，吉安娜感谢且承认贝恩仍参与针对联盟暴行；提供信使安全手札，掩护消息源；贝恩归还锤不等于投奔联盟。",
      "sourceRefs": [
        "text00560:p0076-p0117"
      ]
    },
    {
      "id": "19-f012",
      "type": "fact",
      "characters": [
        "jaina",
        "varian"
      ],
      "summary": "吉安娜布置城防、告知民众实情、日落后两小时宵禁兼顾人性；瓦里安虽斥其信部落，承诺第七军团海军与优秀将领，解释集结时间并联系吉恩。",
      "sourceRefs": [
        "text00561:p0038-p0073",
        "text00561:p0095-p0114"
      ]
    },
    {
      "id": "19-f013",
      "type": "fact",
      "characters": [
        "voljin",
        "thrall"
      ],
      "summary": "沃金参与贝恩秘密会议，追忆森金预示萨尔带来安宁，指出黑暗萨满奴役元素将反噬。哈缪尔称萨尔肯听意见团结部落；这些是人物评价，非萨尔本场行动。加尔鲁什撞破会议威胁众人并贬萨尔。",
      "sourceRefs": [
        "text00562:p0004-p0042"
      ]
    },
    {
      "id": "19-f014",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "部落舰队停界外，吉安娜拒先攻以免成为侵略者；保护贝恩消息来源，赴肯瑞托求援，以平民与大陆平衡劝中立法师协防。",
      "sourceRefs": [
        "text00562:p0062-p0106",
        "text00563:p0019-p0031"
      ]
    },
    {
      "id": "19-f015",
      "type": "fact",
      "characters": [
        "khadgar",
        "jaina"
      ],
      "summary": "卡德加以六人议会成员身份参加吉安娜求援会议，介绍其麦迪文学徒/闭门/外域经历及年龄外貌；吉安娜观察他似认同，不能据此捏造他单独决定援军。",
      "sourceRefs": [
        "text00563:p0017-p0020"
      ]
    },
    {
      "id": "19-f016",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "罗宁率法师仅防御援助，艾萨斯决定性赞成票；吉安娜暂拒回肯瑞托，以保卫人民为先，认为自己创建塞拉摩是和平希望，章节题名“我即塞拉摩”对应此阶段。",
      "sourceRefs": [
        "text00564:p0038-p0042",
        "text00564:p0058-p0082"
      ]
    },
    {
      "id": "19-f017",
      "type": "fact",
      "characters": [
        "voljin"
      ],
      "summary": "沃金与贝恩为免己军面对强化防御而催进攻，并非知道炸弹后共谋；加尔鲁什反令舰队退远，二人困惑。",
      "sourceRefs": [
        "text00565:p0002-p0027"
      ]
    },
    {
      "id": "19-f018",
      "type": "fact",
      "characters": [
        "jaina",
        "varian",
        "malfurion"
      ],
      "summary": "二十艘第七舰队与各族将领抵达，吉安娜感谢瓦里安/玛法里奥等援助；珊蒂斯代述大德鲁伊和泰兰德支持，不可写玛法里奥亲临。",
      "sourceRefs": [
        "text00565:p0029-p0055",
        "text00565:p0075-p0076"
      ]
    },
    {
      "id": "19-f019",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "即使父兄因部落死亡，吉安娜仍反对灭绝仇恨，区分保卫家园与侮辱尸体。卡雷承诺并肩防御，个人情感与使命交织。",
      "sourceRefs": [
        "text00566:p0026-p0052"
      ]
    },
    {
      "id": "19-f020",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "吉安娜派星辰之剑号将所有孩子和愿走的家属平民送加基森；留下者含自愿保家平民，不能称炸弹杀全城所有孩子。",
      "sourceRefs": [
        "text00567:p0005-p0011",
        "text00570:p0064"
      ]
    },
    {
      "id": "19-f021",
      "type": "fact",
      "characters": [
        "jaina",
        "voljin"
      ],
      "summary": "吉安娜与金迪施法守城，识破织歌者削弱北门，仍主张正规审讯；卡雷堵门，沃金发现被困警告贝恩加尔鲁什并组织撤退。吉安娜仍回避先向贝恩开火。",
      "sourceRefs": [
        "text00568:p0011-p0023",
        "text00568:p0051-p0072",
        "text00568:p0086-p0118"
      ]
    },
    {
      "id": "19-f022",
      "type": "fact",
      "characters": [
        "jaina",
        "voljin"
      ],
      "summary": "首次击退后吉安娜安慰金迪见证战争死亡；加尔鲁什向愤怒贝恩/沃金揭示诱集联盟精锐、救织歌者和毁防空后投炸弹计划。沃金先前认为刚发生的是灾难性战败而非预知炸弹。",
      "sourceRefs": [
        "text00569:p0020-p0035",
        "text00569:p0036-p0053"
      ]
    },
    {
      "id": "19-f023",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "法力炸弹造成抑制力场；罗宁与吉安娜合开通往小岛传送门，罗宁引弹入法师塔缩爆炸范围，强推不愿弃城弃友的吉安娜入门，死于爆炸。卡雷空中拦炸弹被击落。",
      "sourceRefs": [
        "text00569:p0060-p0112"
      ]
    },
    {
      "id": "19-f024",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "爆炸改变头发与眼睛，伤重和幸存者自责；返回废墟确认朋友死亡，触碰金迪尸体碎成粉末，愤怒迁移至全部部落并误怀疑贝恩早知情。随后杀来袭兽人并近距离处决最后伤者，以自身能量掩藏聚焦之虹图复仇。",
      "sourceRefs": [
        "text00570:p0023-p0052",
        "text00570:p0053-p0101"
      ]
    },
    {
      "id": "19-f025",
      "type": "fact",
      "characters": [
        "thrall"
      ],
      "summary": "大地之环修复世界已有细微进展，萨尔视其为最有意义快乐工作，阿格娜互相扶持。收到伊崔格信后公开给跨阵营同僚听，自以为吉安娜已死，震惊悲痛。",
      "sourceRefs": [
        "text00571:p0002-p0023"
      ]
    },
    {
      "id": "19-f026",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "听塞拉摩毁灭后萨尔自问任命错误，认吉安娜劝告正确、仍有更大责任；想披甲持锤惩加尔鲁什。努波顿明确允许自由离开，但萨尔选择留下继续紧迫疗伤使命，而非被禁止离开。责任冲突尚未解决。",
      "sourceRefs": [
        "text00571:p0024-p0038"
      ]
    },
    {
      "id": "19-f027",
      "type": "fact",
      "characters": [
        "jaina",
        "varian"
      ],
      "summary": "吉安娜父雕像前认戴琳正确，求立即灭奥格瑞玛。瓦里安不否认反击但拒无策略牺牲，坚持重建舰队/突破封锁，遭其斥懦夫。",
      "sourceRefs": [
        "text00571:p0054-p0090"
      ]
    },
    {
      "id": "19-f028",
      "type": "fact",
      "characters": [
        "varian",
        "malfurion"
      ],
      "summary": "瓦里安与安度因谈丧失和仇恨，认可儿子、认识自身在戈德林祝福后的变化，承诺不仿加尔鲁什手段；布罗尔转达玛法里奥泰兰德会派未受封锁精灵船协助。",
      "sourceRefs": [
        "text00572:p0050-p0070"
      ]
    },
    {
      "id": "19-f029",
      "type": "fact",
      "characters": [
        "khadgar",
        "jaina"
      ],
      "summary": "卡德加代表议会谴责塞拉摩暴行，但拒将达拉然用于灭奥格瑞玛，指出城中商人旅人孤儿无辜、肯瑞托需改革；吉安娜反称孩子长大仍成部落后离去。",
      "sourceRefs": [
        "text00573:p0018-p0028",
        "text00573:p0043-p0048"
      ]
    },
    {
      "id": "19-f030",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "金迪父母反过来安慰她并以点灯幻影纪念女儿；她仍盗取并强破导师封印秘典、隐瞒卡雷聚焦之虹、求其帮复仇遭拒。",
      "sourceRefs": [
        "text00573:p0029-p0042",
        "text00573:p0049-p0073",
        "text00574:p0002-p0028"
      ]
    },
    {
      "id": "19-f031",
      "type": "fact",
      "characters": [
        "varian"
      ],
      "summary": "瓦里安听取联盟代表后改策以双重假情报诱部落往黑海岸，攻奥格瑞玛并希望反对派响应。出征承诺不复制灭城报复，授权安度因留守，承认其贤明及自己可能不归。",
      "sourceRefs": [
        "text00574:p0056-p0081",
        "text00574:p0082-p0116"
      ]
    },
    {
      "id": "19-f032",
      "type": "fact",
      "characters": [
        "thrall"
      ],
      "summary": "元素让萨尔看到水元素被奴役毁奥格瑞玛的幻象，并示勇士岛；这是警告未成事实。众萨满判断仅他受召，他告别阿格娜独往。",
      "sourceRefs": [
        "text00575:p0042-p0073"
      ]
    },
    {
      "id": "19-f033",
      "type": "fact",
      "characters": [
        "voljin"
      ],
      "summary": "剃刀岭旅店被库卡隆爆破后，沃金考虑为族人撤离、冥想寻洛阿意见，随后接联盟舰队逼近报告；并未在此证明正式退出部落。",
      "sourceRefs": [
        "text00574:p0029-p0055",
        "text00575:p0074-p0080"
      ]
    },
    {
      "id": "19-f034",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "萨尔抵勇士岛惊喜她生还，请释元素；吉安娜指责其任命赋权导致惨剧，他愿承担指责但拒杀无辜。她发动潮浪，他以风阻挡；明确对抗神器增幅，非普通实力排名。",
      "sourceRefs": [
        "text00576:p0021-p0042"
      ]
    },
    {
      "id": "19-f035",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "吉安娜意图杀萨尔，他不愿杀曾珍视朋友、冒险压制浪潮；火柱撞水墙、幽灵狼拖延，终全力维系风障无法自卫，宁被杀也不许灭城。卡雷及时到场。",
      "sourceRefs": [
        "text00576:p0043-p0071"
      ]
    },
    {
      "id": "19-f036",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "萨尔明确不阻她对加尔鲁什作战、呼吁勿扼杀孩子未来，并将正义/复仇区别对照同一神器重复暴行；卡雷唤起阿尔萨斯屠城记忆。她主动撤灭城海啸，不是萨尔击败或独自说服。",
      "sourceRefs": [
        "text00576:p0059-p0067",
        "text00576:p0072-p0104"
      ]
    },
    {
      "id": "19-f037",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "吉安娜保留水元素用于援联盟、表明不再不计代价和平，双方深厚友谊断裂而非即时和解；萨尔承认其有理由向部落战争，结束后回大漩涡继续疗伤，不复任大酋长。",
      "sourceRefs": [
        "text00576:p0101-p0113"
      ]
    },
    {
      "id": "19-f038",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "吉安娜赶到刃拳湾后意识到先前海啸会连联盟舰队一起毁灭，内心感谢萨尔与卡雷苟斯；这是她事后获知舰队位置后的判断，不是萨尔事先掌握联盟计划。",
      "sourceRefs": [
        "text00577:p0039-p0044"
      ]
    },
    {
      "id": "19-f039",
      "type": "fact",
      "characters": [
        "jaina",
        "varian"
      ],
      "summary": "瓦里安与加尔鲁什交手时没有被侮辱安度因的话激怒失控；海怪摧毁舰队时先命部下撤退、拒绝优先营救自己，随后绝望转而杀死落水敌人。吉安娜以水元素杀死海怪、卡雷救出瓦里安，三人援军再夺回北方城堡；不能把瓦里安写成全程冷静或这场海战毫无代价的胜利。",
      "sourceRefs": [
        "text00577:p0024-p0030",
        "text00577:p0046-p0073",
        "text00578:p0002-p0023"
      ]
    },
    {
      "id": "19-f040",
      "type": "fact",
      "characters": [
        "voljin"
      ],
      "summary": "加尔鲁什撤回封锁舰队却宣告升级战争；贝恩公开警告不得重演塞拉摩，沃金向贝恩悲哀摇头，叙述从贝恩理解其要保护族人。此时尚不是沃金正式发动起义。",
      "sourceRefs": [
        "text00578:p0029-p0054"
      ]
    },
    {
      "id": "19-f041",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina"
      ],
      "summary": "吉安娜在塞拉摩接受卡雷安慰时回想萨尔关于相互疗愈与伴侣接纳的谈话，仍称那是与“还是朋友的萨尔”的最后谈话。她感谢萨尔阻止灭城、认可旧日劝慰，不等于恢复两人的友谊。",
      "sourceRefs": [
        "text00578:p0082-p0091"
      ]
    },
    {
      "id": "19-f042",
      "type": "fact",
      "characters": [
        "jaina"
      ],
      "summary": "吉安娜重返废墟哀悼，寻回破惧者计划还给安度因并道歉；她放弃复仇但不再认为和平总是最后答案，认为加尔鲁什领导下无法和睦共处；决定返回达拉然，并与卡雷建立亲密关系。",
      "sourceRefs": [
        "text00578:p0067-p0078",
        "text00578:p0094-p0108"
      ]
    },
    {
      "id": "19-f043",
      "type": "fact",
      "characters": [
        "thrall",
        "jaina",
        "khadgar"
      ],
      "summary": "尾声吉安娜归还偷取典籍，并明确说卡雷苟斯和萨尔使她恢复理智；卡德加主持对话、议会商议后邀请她任肯瑞托领袖，继而邀请卡雷入会。预言卷轴未明示她姓名，议会还依据她最终放弃灭城的选择与人格判断，不应写成预言点名或卡德加独断任命。",
      "sourceRefs": [
        "text00579:p0003-p0026",
        "text00579:p0028-p0044"
      ]
    },
    {
      "id": "19-f044",
      "type": "fact",
      "characters": [
        "jaina",
        "varian"
      ],
      "summary": "吉安娜在罗宁追悼仪式承诺聆听议会、传播理性，同时承认其反加尔鲁什立场与中立职责的冲突尚未解决。瓦里安继续备战，加尔鲁什全面动员；本书结尾不是联盟部落达成和平。",
      "sourceRefs": [
        "text00579:p0045-p0071"
      ]
    }
  ],
