  "facts": [
    {
      "id": "08-F01",
      "type": "source_observation",
      "statement": "德拉诺在第二次战争败退中凋敝；耐奥祖见黑暗之门熄灭，血魔带来古尔丹死亡与部落败讯。",
      "evidence": [
        {
          "documentId": "text00208",
          "href": "OEBPS/text00208.html",
          "paragraphStart": "p0002",
          "paragraphEnd": "p0045"
        }
      ]
    },
    {
      "id": "08-F02",
      "type": "source_observation",
      "statement": "门毁两年后，血魔说明艾泽拉斯仍有空间裂隙，提出重开门夺神器再赴其他世界；耐奥祖重新听取计划。",
      "evidence": [
        {
          "documentId": "text00209",
          "href": "OEBPS/text00209.html",
          "paragraphStart": "p0015",
          "paragraphEnd": "p0037"
        }
      ]
    },
    {
      "id": "08-F03",
      "type": "source_observation",
      "statement": "瓦里安已加冕，主持重建暴风城，真诚感谢范克里夫和石工协会；泰瑞纳斯为其成长自豪。",
      "evidence": [
        {
          "documentId": "text00210",
          "href": "OEBPS/text00210.html",
          "paragraphStart": "p0007",
          "paragraphEnd": "p0020"
        }
      ]
    },
    {
      "id": "08-F04",
      "type": "source_observation",
      "statement": "卡德加说明毁掉实体门并未消除裂隙，法师群抑制污染却不能恢复南部土地；瓦里安肯定他们已取得的成果。",
      "evidence": [
        {
          "documentId": "text00210",
          "href": "OEBPS/text00210.html",
          "paragraphStart": "p0022",
          "paragraphEnd": "p0034"
        }
      ]
    },
    {
      "id": "08-F05",
      "type": "source_observation",
      "statement": "卡德加坦承不知何时或多少兽人可能再来，请求洛萨之子军队，瓦里安支持提前准备；他让奥蕾莉亚找图拉扬协调并盼二人和解。",
      "evidence": [
        {
          "documentId": "text00210",
          "href": "OEBPS/text00210.html",
          "paragraphStart": "p0041",
          "paragraphEnd": "p0062"
        }
      ]
    },
    {
      "id": "08-F06",
      "type": "source_observation",
      "statement": "格罗玛什称杜隆坦是已死老友；白爪氏族因同情霜狼受摧残，耐奥祖回忆警告杜隆坦、暗影议会杀死他，认为他高贵。",
      "evidence": [
        {
          "documentId": "text00211",
          "href": "OEBPS/text00211.html",
          "paragraphStart": "p0015",
          "paragraphEnd": "p0039"
        }
      ]
    },
    {
      "id": "08-F07",
      "type": "source_observation",
      "statement": "格罗玛什从胡尔坎取得古尔丹之颅，杀死胡尔坎并以屠杀全族包括幼儿威胁塔加尔重新加入。",
      "evidence": [
        {
          "documentId": "text00212",
          "href": "OEBPS/text00212.html",
          "paragraphStart": "p0025",
          "paragraphEnd": "p0046"
        }
      ]
    },
    {
      "id": "08-F08",
      "type": "source_observation",
      "statement": "图拉扬参与暴风城重建并制止儿童过早的种族仇恨；与奥蕾莉亚争论复仇、正义和圣光普照，保留半数守军而派达纳斯援守望堡。",
      "evidence": [
        {
          "documentId": "text00213",
          "href": "OEBPS/text00213.html",
          "paragraphStart": "p0019",
          "paragraphEnd": "p0090"
        }
      ]
    },
    {
      "id": "08-F09",
      "type": "source_observation",
      "statement": "奥蕾莉亚哀悼利拉斯与亲友；达纳斯如实告知新兵危险、不用谎话鼓动；门重开后新兵阵线崩溃。",
      "evidence": [
        {
          "documentId": "text00213",
          "href": "OEBPS/text00213.html",
          "paragraphStart": "p0091",
          "paragraphEnd": "p0140"
        }
      ]
    },
    {
      "id": "08-F10",
      "type": "source_observation",
      "statement": "德拉诺石拱稳定裂隙，部落回返；格罗玛什攻守望堡实为掩护神器行动。霜狼并未参与该部落行动。",
      "evidence": [
        {
          "documentId": "text00214",
          "href": "OEBPS/text00214.html",
          "paragraphStart": "p0022",
          "paragraphEnd": "p0070"
        }
      ]
    },
    {
      "id": "08-F11",
      "type": "source_observation",
      "statement": "奥特兰克王位争论延续，匹瑞诺德仍被软禁而未正式退位；普瑞斯托影响各王判断。",
      "evidence": [
        {
          "documentId": "text00215",
          "href": "OEBPS/text00215.html",
          "paragraphStart": "p0028",
          "paragraphEnd": "p0079"
        }
      ]
    },
    {
      "id": "08-F12",
      "type": "source_observation",
      "statement": "血魔潜入暴风城发现麦迪文之书已遭窃，以奥特兰克匕首认出线索并藏走证物。",
      "evidence": [
        {
          "documentId": "text00216",
          "href": "OEBPS/text00216.html",
          "paragraphStart": "p0005",
          "paragraphEnd": "p0021"
        }
      ]
    },
    {
      "id": "08-F13",
      "type": "source_observation",
      "statement": "死亡之翼换取自身及货物过门而助血魔；安排奥妮克希亚和奈法利安控制黑石山黑手兄弟。",
      "evidence": [
        {
          "documentId": "text00216",
          "href": "OEBPS/text00216.html",
          "paragraphStart": "p0051",
          "paragraphEnd": "p0084"
        }
      ]
    },
    {
      "id": "08-F14",
      "type": "source_observation",
      "statement": "匹瑞诺德承认盗取麦迪文之书，以书交换黑龙袭灭联盟驻军，儿子奥里登指责其再毁家族名声。",
      "evidence": [
        {
          "documentId": "text00218",
          "href": "OEBPS/text00218.html",
          "paragraphStart": "p0034",
          "paragraphEnd": "p0062"
        }
      ]
    },
    {
      "id": "08-F15",
      "type": "source_observation",
      "statement": "死亡骑士夺达拉然之眼，肯瑞托抵抗未果，萨希拉战死，血魔乘死亡之翼逃走。",
      "evidence": [
        {
          "documentId": "text00219",
          "href": "OEBPS/text00219.html",
          "paragraphStart": "p0017",
          "paragraphEnd": "p0051"
        }
      ]
    },
    {
      "id": "08-F16",
      "type": "source_observation",
      "statement": "芬瑞斯和塔加尔夺萨格拉斯权杖；芬瑞斯拒拉格诺克为萨格拉斯之眼继续冒险。",
      "evidence": [
        {
          "documentId": "text00220",
          "href": "OEBPS/text00220.html",
          "paragraphStart": "p0026",
          "paragraphEnd": "p0047"
        }
      ]
    },
    {
      "id": "08-F17",
      "type": "source_observation",
      "statement": "血魔与黑龙神秘货车返德拉诺，格罗玛什战歌氏族及少数其他战士留守艾泽拉斯。",
      "evidence": [
        {
          "documentId": "text00220",
          "href": "OEBPS/text00220.html",
