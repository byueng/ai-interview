    {
      "id": "08-F22",
      "type": "source_observation",
      "statement": "图拉扬幻见圣光普照各世界并拒以他者牺牲换艾泽拉斯安全；卡德加识破撤军为神器得手后的回返，被碎魂者掐喉，图拉扬救下他。",
      "evidence": [
        {
          "documentId": "text00221",
          "href": "OEBPS/text00221.html",
          "paragraphStart": "p0061",
          "paragraphEnd": "p0085"
        }
