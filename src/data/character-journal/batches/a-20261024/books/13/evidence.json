  "facts": [
    {
      "id": "13-f01",
      "classification": "third-party",
      "statement": "博利克把萨尔解放奴隶视作生活新起点；商船受袭与人类舰船未援助促成争端。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00339:p0004",
        "text00339:p0045",
        "text00339:p0059-p0068"
      ]
    },
    {
      "id": "13-f02",
      "classification": "fact",
      "statement": "萨尔与吉安娜持配对符文石私下联系，在剃刀岭会面；此时盟约依赖私人信任，没有正式协议。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00340:p0003-p0018"
      ]
    },
    {
      "id": "13-f03",
      "classification": "fact",
      "statement": "萨尔仅据本方船员证词愤怒指责，吉安娜要求查证；他恢复冷静并为鲁莽道歉，承认奴役创伤使自己易作最坏推断。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00340:p0018-p0051"
      ]
    },
    {
      "id": "13-f04",
      "classification": "fact",
      "statement": "吉安娜建议正式协议延续两人离去后的和平，萨尔认为值得考虑；这时尚未签订。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00340:p0050-p0052"
      ]
    },
    {
      "id": "13-f05",
      "classification": "fact",
      "statement": "萨尔将吉安娜微笑联想到塔蕾莎，并承认女性角色偏见需学习；吉安娜反驳女人命运由出生决定。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00340:p0055-p0068"
      ]
    },
    {
      "id": "13-f06",
      "classification": "fact",
      "statement": "吉安娜要求独立调查，拒绝克里斯托夫趁机向北方城堡增兵。",
      "characters": [
        "jaina"
      ],
      "sourceRefs": [
        "text00340:p0097-p0133"
      ]
    },
    {
      "id": "13-f07",
      "classification": "fact",
      "statement": "萨尔批准愿意解甲归田的兽人；拜洛克以自由生活回报为忠诚理由，遇火刃袭击。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00342:p0008-p0018",
        "text00342:p0022-p0056"
      ]
    },
    {
      "id": "13-f08",
      "classification": "fact",
      "statement": "萨尔有意采用冷石王座厅营造威严，同时抵制伯克斯排斥人类论，维护吉安娜信誉。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00344:p0002-p0017"
      ]
    },
    {
      "id": "13-f09",
      "classification": "fact",
      "statement": "伐林致雷霆蜥蜴危及农田，萨尔不以魔法嫌疑定罪吉安娜，承认未知，命救援农户、约友调查。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00344:p0023-p0057"
      ]
    },
    {
      "id": "13-f10",
      "classification": "fact",
      "statement": "吉安娜亲查伐林魔法，先搬迁蜥蜴失败，安抚兽群后发现结界并遇艾格文。",
      "characters": [
        "jaina"
      ],
      "sourceRefs": [
        "text00345:p0031-p0048",
        "text00345:p0052-p0098"
      ]
    },
    {
      "id": "13-f11",
      "classification": "fact",
      "statement": "雷克萨带回重伤拜洛克；萨尔先询问伤势允许治疗，拒绝因六个人行为向所有人类开战，重申联手吉安娜对付叛徒且不先发攻击。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00346:p0033-p0064"
      ]
    },
    {
      "id": "13-f12",
      "classification": "fact",
      "statement": "施特罗沃调查火刃遭恶魔杀害；克里斯托夫阻止追查并擅自增兵，双方贸易摩擦被放大为战争借口。",
      "characters": [
        "jaina",
        "thrall"
      ],
      "sourceRefs": [
        "text00347:p0028-p0047",
        "text00348:p0040-p0056",
        "text00350:p0013-p0051"
      ]
    },
    {
      "id": "13-f13",
      "classification": "fact",
      "statement": "吉安娜得知艾格文经历与所读英雄史不同；两人困于兹莫德勒结界。",
      "characters": [
        "jaina"
      ],
      "sourceRefs": [
        "text00349:p0004-p0029",
        "text00351:p0002-p0014",
        "text00351:p0037-p0053"
      ]
    },
    {
      "id": "13-f14",
      "classification": "fact",
      "statement": "克里斯托夫自认能利用恶魔消灭兽人，谎报吉安娜和洛伦娜被火刃兽人绑架，命达文开战。",
      "characters": [
        "jaina",
        "thrall"
      ],
      "sourceRefs": [
        "text00352:p0035-p0047"
      ]
    },
    {
      "id": "13-f15",
      "classification": "fact",
      "statement": "吉安娜请艾格文教穿透术，借洛伦娜外部接应脱困；她以人民责任劝服艾格文重返抗魔，得知其复活麦迪文。",
      "characters": [
        "jaina",
        "khadgar"
      ],
      "sourceRefs": [
        "text00353:p0061-p0093"
      ]
    },
    {
      "id": "13-f16",
      "classification": "fact",
      "statement": "萨尔处理民间纠纷；收到可信斥候洛坎报告人类增兵，亦获卡尔萨赞同，遂下令陆海集结应对进攻，准备被动战争，不是预先知晓恶魔阴谋。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00354:p0002-p0021"
      ]
    },
    {
      "id": "13-f17",
      "classification": "fact",
      "statement": "伯克斯暗中与兹莫德勒合谋，奴役创伤促使其选择恶魔消灭人类，自己认为萨尔对人类过于乐观。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00354:p0022-p0034"
      ]
    },
    {
      "id": "13-f18",
      "classification": "fact",
      "statement": "吉安娜完成蜥蜴安置返回，揭破克里斯托夫勾结；驱魔后克里斯托夫临死承认受控。她需同时止战与打击恶魔，取符文石联系萨尔。",
      "characters": [
        "jaina",
        "thrall"
      ],
      "sourceRefs": [
        "text00355:p0004-p0020",
        "text00355:p0032-p0082"
      ]
    },
    {
      "id": "13-f19",
      "classification": "fact",
      "statement": "伯克斯以萨尔名义要求人类一小时拆除北方城堡，不从即攻击；这是越过萨尔集合待命命令的行为。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00356:p0043-p0049",
        "text00360:p0041"
      ]
    },
    {
      "id": "13-f20",
      "classification": "fact",
      "statement": "北方城堡实际爆发伤亡惨重的混战，里奇视角不记得谁先动手，不可将萨尔止战写为避免了全部流血。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00358:p0002-p0029",
        "text00360:p0002-p0014"
      ]
    },
    {
      "id": "13-f21",
      "classification": "fact",
      "statement": "萨尔以地震、风暴、巨浪打断厮杀，飞艇降临，公开说明伯克斯行为不代表自身意志，命部队撤退。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00360:p0007-p0026"
      ]
    },
    {
      "id": "13-f22",
      "classification": "fact",
      "statement": "萨尔据部下所报火刃护符与吉安娜查明恶魔的通知揭露伯克斯，反对把部分人类的奴役行为视为屠灭人类理由。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00360:p0027-p0032"
      ]
    },
    {
      "id": "13-f23",
      "classification": "fact",
      "statement": "伯克斯当众表示愿与千魔交易杀尽人类，并袭击达文；萨尔击倒他，以酋长身份宣判为各族死者偿命并亲手处决。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00360:p0031-p0038"
      ]
    },
    {
      "id": "13-f24",
      "classification": "fact",
      "statement": "萨尔向达文代表杜隆塔尔道歉，承认来迟，澄清原命令为集合待命，带伤亡者撤走，同时保留应对人类主动挑战的条件。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00360:p0039-p0043"
      ]
    },
    {
      "id": "13-f25",
      "classification": "third-party",
      "statement": "达文认为萨尔止战的威望不仅来自强力，还来自讲话令战士真正放下武器。",
      "characters": [
        "thrall"
      ],
      "sourceRefs": [
        "text00360:p0044-p0046"
      ]
    },
    {
      "id": "13-f26",
      "classification": "fact",
      "statement": "吉安娜耗尽体力难破术士屏障，艾格文传递剩余力量相助；二人将兹莫德勒及术士驱逐扭曲虚空，洛伦娜护卫，吉安娜传送撤离。萨尔未在洞穴参战。",
      "characters": [
        "jaina"
      ],
      "sourceRefs": [
        "text00359:p0009-p0038",
        "text00361:p0004-p0033",
        "text00362:p0021-p0029"
      ]
    },
    {
      "id": "13-f27",
      "classification": "fact",
      "statement": "事后萨尔因亲近副官背叛增强警戒，带护卫会友；双方承认恶魔利用了真实且未消解的两族仇恨，不能把冲突归为纯粹外力或认为族群已自然和解。",
      "characters": [
        "thrall",
        "jaina"
      ],
      "sourceRefs": [
        "text00362:p0003-p0011"
      ]
    },
    {
      "id": "13-f28",
      "classification": "fact",
      "statement": "萨尔与吉安娜同意一周后在中立棘齿城商讨正式盟约细节，萨尔拟带卡尔萨；本书结束未展示签字条款或协议已实施。",
      "characters": [
