  "facts": [
    {
      "id": "07-F01",
      "type": "source_observation",
      "statement": "难民到南海；卡德加19外貌衰老力量返还；瓦里安在洛萨护送下北行；未来德拉诺死亡只是他对幻象的解释",
      "evidence": [
        {
          "documentId": "text00177",
          "href": "OEBPS/text00177.html",
          "paragraphStart": "p0002",
          "paragraphEnd": "p0045"
        }
      ]
    },
    {
      "id": "07-F02",
      "type": "source_observation",
      "statement": "毁灭之锤责古尔丹谋杀杜隆坦；古尔丹叙事确认；为部落需要仍留下术士",
      "evidence": [
        {
          "documentId": "text00178",
          "href": "OEBPS/text00178.html",
          "paragraphStart": "p0024",
          "paragraphEnd": "p0038"
        }
      ]
    },
    {
      "id": "07-F03",
      "type": "source_observation",
      "statement": "泰瑞纳斯称瓦里安陛下，承诺保护与复国",
      "evidence": [
        {
          "documentId": "text00179",
          "href": "OEBPS/text00179.html",
          "paragraphStart": "p0015",
          "paragraphEnd": "p0030"
        }
      ]
    },
    {
      "id": "07-F04",
      "type": "source_observation",
      "statement": "毁灭之锤征服欲与护族并存；古尔丹私谋",
      "evidence": [
        {
          "documentId": "text00180",
          "href": "OEBPS/text00180.html",
          "paragraphStart": "p0002",
          "paragraphEnd": "p0038"
        }
      ]
    },
    {
      "id": "07-F05",
      "type": "source_observation",
      "statement": "卡德加证人支持联盟；瓦里安尚在恢复，阳台偷听会议，阿尔萨斯陪伴",
      "evidence": [
        {
          "documentId": "text00181",
          "href": "OEBPS/text00181.html",
          "paragraphStart": "p0022",
          "paragraphEnd": "p0041"
        }
      ]
    },
    {
      "id": "07-F06",
      "type": "source_observation",
      "statement": "毁灭之锤营救祖尔金，双方结盟；回忆首次结盟遭拒，承认巨魔自主决定",
      "evidence": [
        {
          "documentId": "text00182",
          "href": "OEBPS/text00182.html",
          "paragraphStart": "p0011",
          "paragraphEnd": "p0059"
        }
      ]
    },
    {
      "id": "07-F07",
      "type": "source_observation",
      "statement": "卡德加批评权力者，经法奥提醒收回一概而论；洛萨推荐其为肯瑞托联络并协调法师；同意如实报告麦迪文",
      "evidence": [
        {
          "documentId": "text00183",
          "href": "OEBPS/text00183.html",
          "paragraphStart": "p0019",
          "paragraphEnd": "p0038"
        }
      ]
    },
    {
      "id": "07-F08",
      "type": "source_observation",
      "statement": "法奥设圣骑士修会；p47提里奥具名首四候选之一；49从容；60卡德加认为提里奥本为战士、信仰坚定可能限制战术（人物评价不是验证事实）；推荐格文拉德第五位",
      "evidence": [
        {
          "documentId": "text00183",
          "href": "OEBPS/text00183.html",
          "paragraphStart": "p0043",
          "paragraphEnd": "p0064"
        }
      ]
    },
    {
      "id": "07-F09",
      "type": "source_observation",
      "statement": "古尔丹杀死灵法师制心脏宝石、以死亡议会灵魂入人尸，塔隆血魔首死亡骑士；毁灭之锤接纳而术士图私利",
      "evidence": [
        {
          "documentId": "text00184",
          "href": "OEBPS/text00184.html",
          "paragraphStart": "p0013",
          "paragraphEnd": "p0040"
        }
      ]
    },
    {
      "id": "07-F10",
      "type": "source_observation",
      "statement": "部落北进占矿建舰计划，火山被兽人解释祝福（非客观证明）",
      "evidence": [
        {
          "documentId": "text00184",
          "href": "OEBPS/text00184.html",
          "paragraphStart": "p0041",
          "paragraphEnd": "p0059"
        }
      ]
    },
    {
      "id": "07-F11",
      "type": "source_observation",
      "statement": "卡德加识破肯瑞托伪装要求公开相见；完整报告；保留取走书籍不告；对召回明确拒绝，选择履行对洛萨承诺与友谊；获自主认可；窥视会议获摧门目标",
      "evidence": [
        {
          "documentId": "text00185",
          "href": "OEBPS/text00185.html",
          "paragraphStart": "p0007",
          "paragraphEnd": "p0048"
        }
      ]
    },
    {
      "id": "07-F12",
      "type": "source_observation",
      "statement": "卡德加为洛萨客观顾问；奥蕾莉亚自愿支援（精灵王仅象征舰队）；部落海上将至",
      "evidence": [
        {
          "documentId": "text00185",
          "href": "OEBPS/text00185.html",
          "paragraphStart": "p0050",
          "paragraphEnd": "p0085"
        }
      ]
    },
    {
      "id": "07-F13",
      "type": "source_observation",
      "statement": "卡德加对图拉扬坦诚每战恐惧，用洛萨经验安慰",
      "evidence": [
        {
          "documentId": "text00186",
          "href": "OEBPS/text00186.html",
          "paragraphStart": "p0007",
          "paragraphEnd": "p0013"
        }
      ]
    },
    {
      "id": "07-F14",
      "type": "source_observation",
      "statement": "卡德加召暴风闪电协防，有限魔力耗竭；盟军守线而非彻底击溃兽人",
      "evidence": [
        {
          "documentId": "text00186",
          "href": "OEBPS/text00186.html",
          "paragraphStart": "p0035",
          "paragraphEnd": "p0040"
        }
      ]
    },
    {
      "id": "07-F15",
      "type": "source_observation",
      "statement": "祖鲁希德寻恶魔之魂，耐克鲁斯操作奴役红龙女王，以杀蛋折磨迫红龙效力；萨满过去回忆是祖鲁希德视角",
      "evidence": [
        {
          "documentId": "text00187",
          "href": "OEBPS/text00187.html",
          "paragraphStart": "p0012",
          "paragraphEnd": "p0042"
        }
      ]
    },
    {
      "id": "07-F16",
      "type": "source_observation",
      "statement": "卡德加建议救矮人结盟、传令、随图拉扬半军援精灵；库德兰结盟，发现辛特兰为佯攻",
