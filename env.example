# 必填：首次填写三项。单引号可避免密钥中的 $ 被 Compose 展开。
API_KEY=''
BASE_URL=''
MODEL_NAME=''
TEMPERATURE=0.8
# Docker 网页端口；只绑定 127.0.0.1。
APP_PORT=8080
# 可选：多个部署使用不同项目名和端口，各自拥有独立数据卷。
# COMPOSE_PROJECT_NAME=ai-interview
# 可选：本机 Docker 凭据助手卡住时，匿名拉取公共基础镜像；不改 Docker 全局配置。
# AI_INTERVIEW_ANONYMOUS_BUILD=1
# 可选：覆盖默认 src/data；应使用绝对路径或相对当前工作目录的路径。
# 仅本地 Python 启动使用；Docker 固定为 /app/data 命名卷。
# DATA_DIR=""

# 可选：启用 LangSmith 时再填写凭据。
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=''
LANGSMITH_PROJECT=ai-interview
